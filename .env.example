# -----------------------------------------------------------------------------
# Ticmark Properties — environment variables
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. All of them are optional:
# the site builds and runs with none set.
# -----------------------------------------------------------------------------

# Public URL of the live site (no trailing slash). Used for canonical URLs,
# sitemap.xml, robots.txt, Open Graph images and structured data.
# If empty on Vercel, the production domain Vercel assigns is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.ticmarkproperties.com

# Phone and WhatsApp numbers in international format, e.g. 923001234567
# (spaces, dashes and "+" are ignored). While empty, the site shows
# "+92 XXX XXXXXXX" and Call / WhatsApp buttons open the Contact page instead.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Maps embed for the Contact page map. In Google Maps: Share → Embed a map
# → copy only the URL inside src="...". While empty, a styled placeholder is shown.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Server-only webhooks. Form submissions are POSTed here as JSON (works with
# Formspree, Zapier, Make, n8n, Slack workflows or your own CRM endpoint).
# While empty, forms still validate and confirm, but nothing is delivered.
INQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
